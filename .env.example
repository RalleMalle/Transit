# Statischer HVV-Fahrplan (GTFS). Die URL ändert sich bei neuen Fahrplänen!
# Alternativ: ZIP manuell nach data\gtfs.zip legen (dann wird nichts geladen).
GTFS_URL=https://daten.transparenz.hamburg.de/Dataport.HmbTG.ZS.Webservice.GetRessource100/GetRessource100.svc/f0073555-962c-4d55-870e-b94bb676ad9d/Upload__hvv_Rohdaten_GTFS_Fpl_20260408.ZIP
# Optional: GTFS-Realtime-Feed mit Fahrzeugpositionen (Protobuf-URL). Leer = nur Fahrplan.
GTFS_RT_VEHICLES_URL=

# Optional: HVV-GTI-Zugang (Echtzeit/Verspätungen). Nach Freischaltung durch den HVV eintragen.
GTI_USER=
GTI_PASS=

# Echtzeit-Feeds (GTFS-RT), kommagetrennt, erste Quelle hat Vorrang. Leer lassen = nur Standard (gtfs.de).
# Zum Abschalten: GTFS_RT_URLS= (leer) setzen.
# GTFS_RT_URLS=https://realtime.gtfs.de/realtime-free.pb

# Kartenkacheln (Standard: OpenStreetMap, kein Schlüssel nötig). Eigener Anbieter mit Schlüssel hier eintragen:
# TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
